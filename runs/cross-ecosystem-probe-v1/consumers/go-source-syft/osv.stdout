                },
                {
                  "type": "FIX",
                  "url": "https://go.dev/cl/826524"
                },
                {
                  "type": "WEB",
                  "url": "https://groups.google.com/g/golang-announce/c/1y3fb2np35U"
                }
              ],
              "related": [
                "RHSA-2026:70640"
              ],
              "schema_version": "1.9.0",
              "summary": "Prevent DoS on deadlocked established channel in golang.org/x/crypto/ssh"
            },
