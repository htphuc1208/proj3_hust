                  "url": "https://go.dev/cl/797040"
                }
              ],
              "related": [
                "CGA-gppf-q4hh-4rj4"
              ],
              "schema_version": "1.9.0",
              "summary": "Source-address critical option not enforced for non-public-key auth callbacks in golang.org/x/crypto/ssh"
            },
