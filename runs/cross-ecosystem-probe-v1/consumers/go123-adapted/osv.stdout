              "schema_version": "1.9.0",
              "summary": "Invoking failure to reject ASCII-only Punycode-encoded labels in golang.org/x/net/idna"
            },
            {
              "affected": [
                {
                  "database_specific": {
                    "source": "https://vuln.go.dev/ID/GO-2026-5037.json"
                  },
                  "ecosystem_specific": {
