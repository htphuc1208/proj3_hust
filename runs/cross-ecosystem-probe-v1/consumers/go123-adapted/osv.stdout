                  "url": "https://groups.google.com/g/golang-dev/c/t0rK-qHBqzY/m/6MMoAZkMAgAJ"
                }
              ],
              "related": [
                "CGA-7r9v-mf57-276j"
              ],
              "schema_version": "1.7.3",
              "summary": "Denial of service due to improper 100-continue handling in net/http"
            },
