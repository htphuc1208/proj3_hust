                  "type": "FIX",
                  "url": "https://go.dev/cl/839866"
                },
                {
                  "type": "REPORT",
                  "url": "https://go.dev/issue/81821"
                },
                {
                  "type": "WEB",
                  "url": "https://groups.google.com/g/golang-announce/c/U2fTuyDJznI"
                }
              ],
              "schema_version": "1.9.0",
              "summary": "Reset context tracking on consecutive template expressions in html/template"
            },
