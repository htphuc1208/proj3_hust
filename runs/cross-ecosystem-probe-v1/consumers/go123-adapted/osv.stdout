              "database_specific": {
                "review_status": "REVIEWED",
                "url": "https://pkg.go.dev/vuln/GO-2026-6611"
              },
              "details": "A malicious HTTP/2 peer can cause excessive CPU consumption in the client or server by opening a large number of streams and then sending many small SETTINGS frames containing SETTINGS_INITIAL_WINDOW_SIZE values.",
              "id": "GO-2026-6611",
              "modified": "2026-10-16T09:55:38.952277866Z",
              "published": "2026-10-08T22:31:09Z",
              "references": [
