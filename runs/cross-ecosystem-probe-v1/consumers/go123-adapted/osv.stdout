                  "type": "WEB",
                  "url": "https://groups.google.com/g/golang-announce/c/lVEm7llp0w0/m/VbafyRkgCgAJ"
                }
              ],
              "schema_version": "1.7.3",
              "summary": "Panic on invalid DSA public keys in crypto/dsa"
            },
