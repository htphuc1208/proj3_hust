                  "type": "WEB",
                  "url": "https://groups.google.com/g/golang-announce/c/0fM21h43arc"
                },
                {
                  "type": "REPORT",
                  "url": "https://go.dev/issue/48085"
                }
              ],
              "schema_version": "1.7.3",
              "summary": "Panic when opening certain archives in archive/zip"
            },
