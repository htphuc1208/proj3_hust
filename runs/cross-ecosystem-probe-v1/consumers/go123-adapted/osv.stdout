                  "type": "REPORT",
                  "url": "https://go.dev/issue/40618"
                },
                {
                  "type": "WEB",
                  "url": "https://groups.google.com/g/golang-announce/c/NyPIaucMgXo"
                }
              ],
              "schema_version": "1.7.3",
              "summary": "Unbounded read from invalid inputs in encoding/binary"
            },
