                      {
                        "path": "crypto/x509",
                        "symbols": [
                          "Certificate.Verify",
                          "Certificate.VerifyHostname",
                          "HostnameError.Error",
                          "matchHostnames"
                        ]
                      }
                    ]
                  },
                  "package": {
                    "ecosystem": "Go",
                    "name": "stdlib",
                    "purl": "pkg:golang/stdlib"
                  },
                  "ranges": [
