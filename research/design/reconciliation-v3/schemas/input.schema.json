{
  "$defs": {
    "ArtifactTargetV3": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/BlobReferenceV3"
        },
        "boundary": {
          "const": "supplied_artifact",
          "default": "supplied_artifact",
          "title": "Boundary",
          "type": "string"
        },
        "kind": {
          "enum": [
            "java_jar",
            "js_bundle",
            "native_binary"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "kind"
      ],
      "title": "ArtifactTargetV3",
      "type": "object"
    },
    "BlobReferenceV3": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "BlobReferenceV3",
      "type": "object"
    },
    "ConsumerEvaluationV3": {
      "additionalProperties": false,
      "properties": {
        "advisory_snapshot": {
          "$ref": "#/$defs/BlobReferenceV3"
        },
        "configuration": {
          "$ref": "#/$defs/BlobReferenceV3"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "snapshot_kind": {
          "enum": [
            "DATABASE",
            "RECORDED_RESPONSES"
          ],
          "title": "Snapshot Kind",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "configuration",
        "advisory_snapshot",
        "snapshot_kind"
      ],
      "title": "ConsumerEvaluationV3",
      "type": "object"
    },
    "ContextKnowledgeV3": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Architecture"
        },
        "build_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Build Profile"
        },
        "context_id": {
          "minLength": 1,
          "title": "Context Id",
          "type": "string"
        },
        "entrypoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entrypoint"
        },
        "features_by_subject": {
          "additionalProperties": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Features By Subject",
          "type": "object"
        },
        "os": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Os"
        },
        "runtimes": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Runtimes",
          "type": "object"
        }
      },
      "required": [
        "context_id"
      ],
      "title": "ContextKnowledgeV3",
      "type": "object"
    },
    "EvidenceInputV3": {
      "additionalProperties": false,
      "properties": {
        "blob": {
          "$ref": "#/$defs/BlobReferenceV3"
        },
        "claimed_target_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claimed Target Sha256"
        },
        "kind": {
          "enum": [
            "sbom",
            "artifact_bytes",
            "manifest",
            "lockfile",
            "native_resolution",
            "build_record",
            "registry_metadata",
            "registry_archive",
            "bundler_metafile"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "blob",
        "kind"
      ],
      "title": "EvidenceInputV3",
      "type": "object"
    },
    "ProducerV3": {
      "additionalProperties": false,
      "properties": {
        "configuration_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configuration Sha256"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "name"
      ],
      "title": "ProducerV3",
      "type": "object"
    },
    "ReconciliationTargetV3": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactTargetV3"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "context": {
          "$ref": "#/$defs/ContextKnowledgeV3"
        },
        "project_ref": {
          "minLength": 1,
          "title": "Project Ref",
          "type": "string"
        },
        "revision_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision Ref"
        },
        "target_id": {
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "view": {
          "enum": [
            "DECLARED",
            "RESOLVED",
            "ARTIFACT"
          ],
          "title": "View",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "project_ref",
        "context",
        "view"
      ],
      "title": "ReconciliationTargetV3",
      "type": "object"
    },
    "SbomObservationV3": {
      "additionalProperties": false,
      "properties": {
        "claimed_artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claimed Artifact Sha256"
        },
        "context_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Id"
        },
        "document": {
          "$ref": "#/$defs/BlobReferenceV3"
        },
        "format": {
          "enum": [
            "CycloneDX",
            "SPDX"
          ],
          "title": "Format",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ProducerV3"
        },
        "revision_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision Ref"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "target_id": {
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "view": {
          "enum": [
            "DECLARED",
            "RESOLVED",
            "ARTIFACT",
            "UNKNOWN"
          ],
          "title": "View",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "document",
        "format",
        "producer",
        "target_id",
        "view"
      ],
      "title": "SbomObservationV3",
      "type": "object"
    }
  },
  "$id": "urn:sbom-recovery:reconciliation-v3:input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "consumer": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConsumerEvaluationV3"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/SbomObservationV3"
      },
      "minItems": 2,
      "title": "Documents",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceInputV3"
      },
      "title": "Evidence",
      "type": "array"
    },
    "policy_id": {
      "minLength": 1,
      "title": "Policy Id",
      "type": "string"
    },
    "schema_version": {
      "const": "sbom-reconciliation-input-v3",
      "default": "sbom-reconciliation-input-v3",
      "title": "Schema Version",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/ReconciliationTargetV3"
    }
  },
  "required": [
    "target",
    "documents",
    "policy_id"
  ],
  "title": "ReconciliationRequestV3",
  "type": "object"
}
